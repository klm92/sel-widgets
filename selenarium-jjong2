<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta http-equiv="X-Frame-Options" content="ALLOWALL">
<meta http-equiv="Content-Security-Policy" content="frame-ancestors *">
<title>Selenarium · For Jonghyun</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&family=Josefin+Sans:wght@100;200;300&family=IM+Fell+English:ital@0;1&family=Nanum+Pen+Script&display=swap');

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

body{
  background:#191919;
  color:#e8dfc8;
  font-family:'Josefin Sans',sans-serif;
  font-weight:300;
  min-height:100vh;
  padding:28px 22px 32px;
  position:relative;
  overflow:hidden;
  display:flex;
  flex-direction:column;
  align-items:center;
}

/* Deep starfield */
.stars{
  position:fixed;
  top:0;
  left:0;
  width:100%;
  height:100%;
  pointer-events:none;
  z-index:0;
}

.star{
  position:absolute;
  background:white;
  border-radius:50%;
  animation:twinkle var(--d) ease-in-out infinite;
  animation-delay:var(--delay);
}

@keyframes twinkle{
  0%,100%{opacity:var(--op)}
  50%{opacity:calc(var(--op)*0.08)}
}

.widget{
  position:relative;
  z-index:1;
  width:100%;
  max-width:310px;
  text-align:center;
}

/* Moon */
.moon-wrap{
  position:relative;
  display:inline-block;
  margin-bottom:20px;
}

.moon-glow{
  position:absolute;
  top:50%;
  left:50%;
  transform:translate(-50%,-50%);
  width:130px;
  height:130px;
  border-radius:50%;
  background:radial-gradient(circle, rgba(232,216,180,0.25) 0%, rgba(180,150,80,0.08) 50%, transparent 75%);
  animation:breathe 6s ease-in-out infinite;
  pointer-events:none;
</html>
